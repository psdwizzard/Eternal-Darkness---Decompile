Hypothesis: MWCC GC/1.3 may prioritize register-qualified parameter aliases over
later-loaded long-lived scalar/pointer values without changing instruction order.

The following exact source experiment was compiled, measured, and reverted:

diff --git a/src/game/game_fn_8019C4E4.c b/src/game/game_fn_8019C4E4.c
--- a/src/game/game_fn_8019C4E4.c
+++ b/src/game/game_fn_8019C4E4.c
@@ -23,11 +23,11 @@
 void fn_8019C4E4(u8* object, void* first, void* second, u8* config)
 {
-    register u8 count;
-    register u8* entry;
-    u8* cfg;
-    void* base;
-    u8* self;
+    u8 count;
+    u8* entry;
+    register u8* cfg;
+    register void* base;
+    register u8* self;
     int i;
     struct { u32 word; u16 half; } setup;
     struct { u32 word; u16 half; } value;

